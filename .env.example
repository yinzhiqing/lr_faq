# 复制为 .env 后由 docker compose 读取
# openssl rand -base64 48
SESSION_SECRET=

# 数据库与上传文件在宿主机的目录（默认未设置时为项目下 ./data）
# 生产建议绝对路径，例如：DATA_HOST_PATH=/var/lib/faq-system/data
# DATA_HOST_PATH=./data

# 映射到宿主机的端口
PUBLISH_PORT=3000

# 置于反向代理后时设为 1
# TRUST_PROXY=1

# 站点为 HTTPS 且前端经代理访问时设为 true（否则登录态 cookie 可能无法写入）
# SESSION_COOKIE_SECURE=true
